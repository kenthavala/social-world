# --- LLM provider ---
# Which preset to use: openrouter | opencode_zen | nvidia_nim | kilo | fcc | tokenharbor | custom | mock
LLM_PROVIDER=mock
LLM_MODEL=
LLM_MODEL_FAST=
LLM_BASE_URL=              # only for custom, or to override a preset
LLM_WIRE_FORMAT=           # only for custom: openai_chat | anthropic_messages
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=90
LLM_RPM=                   # blank = preset default
LLM_CONCURRENCY=2
LLM_FALLBACK_MODELS=       # comma-separated, same provider
LLM_FALLBACK_PROVIDER=     # optional second preset
LLM_CACHE=true

# --- Provider keys ---
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
NVIDIA_API_KEY=
KILOCODE_API_KEY=
FCC_BASE_URL=http://127.0.0.1:8082/v1
FCC_API_KEY=               # the proxy auth token you set in the fcc Admin UI
TOKENHARBOR_API_KEY=
LLM_API_KEY=               # custom only

# --- Limits ---
MAX_UPLOAD_MB=50
MAX_PAGES=200
PORT=8000
